{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gen1Recomp Studio",
  "version": "0.1.0",
  "identifier": "dev.gen1recomp.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gen1Recomp Studio",
        "width": 1500,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4QUEyMkQyQUIwQjk5NEEKUldSS21RdXIwaUtxQ0JDQWxxdE9MQll0NEdTcVc0d0NEZGRNeGJrOXp0d2UweThEa2ZzL1MvaUIK",
      "endpoints": ["https://github.com/AlfonsPistoletti/gen1recomp-studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
